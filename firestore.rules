rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function getPlanLimit(plan) {
      return {
        'convidado': 10,
        'plano_unico': 1,
        'plano_duplo': 2,
        'plano_acelerador': 4,
        'desenvolvedor': 999
      }[plan];
    }
    
    function isUsageWithinLimit(userId) {
        let user = get(/databases/$(database)/documents/users/$(userId)).data;
        let plan = user.plan;
        
        // Developer plan has no limits
        if (plan == 'desenvolvedor') {
            return true;
        }

        let usage = user.usage;
        let limit = getPlanLimit(plan);
        
        // Check if the usage cycle needs to be reset
        let currentMonth = request.time.month();
        let cycleMonth = usage.cycleStart.month();
        
        let reportsThisCycle = (currentMonth == cycleMonth) ? usage.reportsThisCycle : 0;
        
        return reportsThisCycle < limit;
    }

    // --- Validation Functions ---
    function isCreatingOwnUser() {
      let data = request.resource.data;
      return data.email == request.auth.token.email
          && data.createdAt == request.time
          && data.lastLoginAt == request.time
          && data.plan == 'convidado'
          && data.planStatus == 'active'
          && data.usage.reportsThisCycle == 0
          && data.usage.cycleStart == request.time;
    }

    function isUpdatingOwnProfile() {
      let data = request.resource.data;
      let existingData = resource.data;

      // User can't change their own plan or status, or critical immutable fields
      let coreFieldsUnchanged = data.plan == existingData.plan
          && data.planStatus == existingData.planStatus
          && data.createdAt == existingData.createdAt;

      // Allow user to reset their usage stats if a new month has started
      let isResettingUsage = data.usage.reportsThisCycle == 0
          && data.usage.cycleStart.month() == request.time.month()
          && request.time.month() != existingData.usage.cycleStart.month();

      return coreFieldsUnchanged && (
        // Allow updating non-critical fields OR resetting usage
        (data.lastLoginAt == request.time && data.usage == existingData.usage) || isResettingUsage
      );
    }
    
    function isAdminUpdatingUser() {
      let data = request.resource.data;
       // Admin can change plan and status, but not immutable fields.
      return data.createdAt == resource.data.createdAt;
    }

    function isValidUsageEvent(userId) {
      let data = request.resource.data;
      // Also check if user is within their plan limit before allowing event creation
      return data.userId == userId
          && data.timestamp <= request.time
          && isUsageWithinLimit(userId);
    }

    function isUpdatingOwnUsageEventStatus(userId) {
        let data = request.resource.data;
        // User must be the owner
        return data.userId == userId
            // Only allow updating status and metadata.
            && data.action == resource.data.action
            && data.timestamp == resource.data.timestamp;
    }

    function isValidDiagnosisReport(userId) {
      let data = request.resource.data;
      return data.userId == userId
        && data.createdAt == request.time;
    }

    // --- Collection Rules ---

    match /roles_admin/{userId} {
      allow read: if isAdmin();
      allow list, write: if false;
    }
    
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isCreatingOwnUser();
      allow update: if (isOwner(userId) && isUpdatingOwnProfile()) || (isAdmin() && isAdminUpdatingUser());
      allow delete: if false;
      
      // --- Subcollection Rules ---
       match /usageEvents/{usageEventId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidUsageEvent(userId);
        allow update: if isOwner(userId) && isUpdatingOwnUsageEventStatus(userId);
        allow delete: if false;
      }
      
      match /diagnosisReports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidDiagnosisReport(userId);
        allow update, delete: if false;
      }
    }
  }
}
