rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // This function causes a read. Ensure rules on `roles_admin` allow this.
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isSelfActive() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn() && userDoc != null && userDoc.data.status == 'active';
    }

    // --- Validation Functions ---
    function isCreatingOwnUser() {
      let data = request.resource.data;
      return data.email == request.auth.token.email
          && data.role == 'user'
          && data.status == 'active'
          && data.plan == 'Plano Único'
          && data.createdAt == request.time
          && data.lastLoginAt == request.time;
    }

    function isUpdatingOwnProfile() {
      let data = request.resource.data;
      // User can't change their own role, status, or plan.
      return data.role == resource.data.role
          && data.status == resource.data.status
          && data.plan == resource.data.plan
          && data.createdAt == resource.data.createdAt; // Immutable
    }
    
    function isAdminUpdatingUser() {
      let data = request.resource.data;
       // Admin can change role and status, but not immutable fields.
      return data.createdAt == resource.data.createdAt;
    }

    function isValidUsageEvent(userId) {
      let data = request.resource.data;
      return data.userId == userId
          && data.timestamp <= request.time;
    }

    function isUpdatingOwnUsageEventStatus(userId) {
        let data = request.resource.data;
        // User must be the owner
        return data.userId == userId
            // Only allow updating status and metadata.
            && data.action == resource.data.action
            && data.timestamp == resource.data.timestamp;
    }

    function isValidDiagnosisReport(userId) {
      let data = request.resource.data;
      return data.userId == userId
        && data.createdAt == request.time;
    }

    // --- Collection Rules ---

    // Admin roles are managed via backend/console, not client.
    // Any signed-in user can check a specific user's admin status.
    // Only admins can list all admins.
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if false;
    }

    // User profiles can be read by owner or admin.
    // Only admins can list all users.
    // Users can create their own profile.
    // Users can update their own profile (with restrictions).
    // Admins can update any user's profile (role/status/plan).
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isCreatingOwnUser();
      allow update: if (isOwner(userId) && isUpdatingOwnProfile()) || (isAdmin() && isAdminUpdatingUser());
      allow delete: if false; // Users should be suspended, not deleted.

      // Subcollections for a User
      
      // Usage events are private.
      // Only active users can create events.
      // Admins can read anyone's events for auditing.
      match /usageEvents/{usageEventId} {
        allow read: if (isOwner(userId) && isSelfActive()) || isAdmin();
        allow create: if isOwner(userId) && isSelfActive() && isValidUsageEvent(userId);
        allow update: if isOwner(userId) && isSelfActive() && isUpdatingOwnUsageEventStatus(userId);
        allow delete: if false;
      }
      
      // Diagnosis reports are private.
      match /diagnosisReports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isSelfActive() && isValidDiagnosisReport(userId);
        allow update, delete: if false;
      }
    }
  }
}
