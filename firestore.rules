rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Check if the user is a member of the tenant
    function isTenantMember(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    // --- Collection Rules ---

    // Regra para Administradores
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
    
    // Regras de Usuário (Isolamento por UID)
    match /users/{userId} {
      // Permite leitura e escrita completa do próprio nó de usuário
      allow read, write: if isOwner(userId) || isAdmin();

      // Regras explícitas para subcoleções para evitar ambiguidades de herança
      match /priceCalculations/{calculationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /diagnosisReports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
      }

      match /usageEvents/{eventId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Estrutura multi-tenant para diagnósticos e produtos
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isAdmin();
      
      match /diagnostics/{diagnosticId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if false; // Apenas via Admin SDK (Functions)
      }

      match /products/{productId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if false;
      }
    }

    // Eventos de faturamento e webhooks (Apenas Admin)
    match /billing_events/{eventId} {
      allow read, write: if isAdmin();
    }
  }
}