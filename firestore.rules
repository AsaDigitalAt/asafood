rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Check if the user is a member of the tenant
    function isTenantMember(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    // --- Collection Rules ---

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
    
    match /users/{userId} {
      // Permitir leitura e escrita do próprio perfil
      allow read, write: if isOwner(userId) || isAdmin();

      // Permitir que o usuário liste e gerencie seus próprios cálculos de preço
      match /priceCalculations/{calculationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // Reports legados (leitura apenas)
      match /diagnosisReports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
      }
    }

    // Estrutura multi-tenant para diagnósticos
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isAdmin();
      
      match /diagnostics/{diagnosticId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if false; // Escrita apenas via Admin SDK
      }

      match /products/{productId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if false;
      }
    }

    match /billing_events/{eventId} {
      allow read, write: if false; // Apenas via Admin SDK / Webhooks
    }
  }
}