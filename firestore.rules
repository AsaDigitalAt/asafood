rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // --- Collection Rules ---

    // Admin Roles
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
    
    // User Data Tree - Permissão total e explícita para o dono
    // Esta regra garante que o usuário acesse seu perfil e todas as subcoleções (diagnósticos, cálculos, etc)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Tenancy-based structures (for shared diagnostics/products if used)
    match /tenants/{tenantId} {
      allow read, write: if isOwner(tenantId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(tenantId) || isAdmin();
      }
    }

    // Billing events (Admin only)
    match /billing_events/{eventId} {
      allow read: if isAdmin();
    }
  }
}