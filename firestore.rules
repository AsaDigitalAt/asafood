rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Check if the user is a member of the tenant
    function isTenantMember(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    // --- Collection Rules ---

    // Admin Roles
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
    
    // User Data Tree - Permissão total para o dono em qualquer profundidade
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Multi-tenant structures
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isAdmin();
      
      match /diagnostics/{diagnosticId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
      }

      match /products/{productId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
      }
    }

    // Billing events
    match /billing_events/{eventId} {
      allow read: if isAdmin();
    }
  }
}