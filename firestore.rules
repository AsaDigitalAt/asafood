rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function getPlanLimit(plan) {
      return {
        'convidado': 10,
        'plano_unico': 1,
        'plano_duplo': 2,
        'plano_acelerador': 4,
        'desenvolvedor': 999
      }[plan];
    }
    
    function isWithinMonthlyLimit(userId) {
        let userData = get(/databases/$(database)/documents/users/$(userId)).data;
        let plan = userData.get('plan', 'plano_acelerador');
        let limit = getPlanLimit(plan);
        let usage = userData.get('usage', null);
        // Ternary to check for new cycle or null usage
        let reportsThisCycle = usage != null && usage.cycleStart.month() == request.time.month() 
            ? usage.reportsThisCycle 
            : 0;

        // Return true if developer OR if reports are under the limit
        return plan == 'desenvolvedor' || reportsThisCycle < limit;
    }

    // --- Validation Functions ---
    function isCreatingOwnUser() {
      let data = request.resource.data;
      return data.email == request.auth.token.email
          && data.plan == 'plano_acelerador'
          && data.planStatus == 'active'
          && data.usage.reportsThisCycle == 0
          && data.createdAt is timestamp
          && data.lastLoginAt is timestamp
          && data.usage.cycleStart is timestamp;
    }

    function isUpdatingOwnProfile() {
      let incoming = request.resource.data;
      let existing = resource.data;
      let newUsage = incoming.usage;
      let existingUsage = existing.get('usage', null);

      // 1. Immutable fields that user cannot change
      let coreDataUnchanged = incoming.email == existing.email 
                          && incoming.createdAt == existing.createdAt
                          && incoming.plan == existing.plan 
                          && incoming.planStatus == existing.planStatus;

      // 2. User can update lastLoginAt only to the request time, or it can remain unchanged
      let lastLoginAtValid = incoming.lastLoginAt == existing.lastLoginAt || incoming.lastLoginAt == request.time;
      
      // 3. Validate 'usage' update logic
      let usageValid = 
          // Case 1: 'usage' field is not being updated.
          (incoming.usage == existing.usage) ||
          // Case 2: 'usage' field IS being updated. It must be a valid increment or reset.
          (
              // Subcase A: First time usage is set for an old user
              (existingUsage == null && newUsage.reportsThisCycle == 1 && newUsage.cycleStart == request.time) ||
              // Subcase B: Usage already exists, check increment or reset
              (existingUsage != null && (
                  // B1: Incrementing report count by 1, for the same cycle
                  (newUsage.reportsThisCycle == existingUsage.reportsThisCycle + 1 && newUsage.cycleStart.toMillis() == existingUsage.cycleStart.toMillis()) ||
                  // B2: Resetting for a new month
                  (newUsage.reportsThisCycle == 0 && newUsage.cycleStart.month() != existingUsage.cycleStart.month() && newUsage.cycleStart.year() == request.time.year())
              ))
          );

      return coreDataUnchanged && lastLoginAtValid && usageValid;
    }
    
    function isAdminUpdatingUser() {
      let data = request.resource.data;
       // Admin can change plan and status, but not immutable fields like createdAt.
      return data.createdAt == resource.data.createdAt;
    }

    function isValidUsageEvent(userId) {
      let data = request.resource.data;
      // Also check if user is within their plan limit before allowing event creation
      return data.userId == userId
          && data.timestamp <= request.time
          && isWithinMonthlyLimit(userId);
    }

    function isUpdatingOwnUsageEventStatus(userId) {
        let data = request.resource.data;
        // User must be the owner
        return data.userId == userId
            // Only allow updating status and metadata.
            && data.action == resource.data.action
            && data.timestamp == resource.data.timestamp;
    }

    function isValidDiagnosisReport(userId) {
      let data = request.resource.data;
      return data.userId == userId
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
    
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isCreatingOwnUser();
      allow update: if (isOwner(userId) && isUpdatingOwnProfile()) || (isAdmin() && isAdminUpdatingUser());
      allow delete: if false;
      
      // --- Subcollection Rules ---
       match /usageEvents/{usageEventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidUsageEvent(userId);
        allow update: if isOwner(userId) && isUpdatingOwnUsageEventStatus(userId);
        allow delete: if false;
      }
      
      match /diagnosisReports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidDiagnosisReport(userId) && isWithinMonthlyLimit(userId);
        allow update, delete: if false;
      }
    }
  }
}
