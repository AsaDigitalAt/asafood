rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // This function causes a read. Ensure rules on `roles_admin` allow this.
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isSelfActive() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // --- Validation Functions ---
    function isCreatingOwnUser() {
      let data = request.resource.data;
      return data.email == request.auth.token.email
          && data.role == 'user'
          && data.status == 'active'
          && data.createdAt == request.time
          && data.lastLoginAt == request.time;
    }

    function isUpdatingOwnProfile() {
      let data = request.resource.data;
      // User can't change their own role or status.
      return data.role == resource.data.role
          && data.status == resource.data.status
          && data.createdAt == resource.data.createdAt; // Immutable
    }
    
    function isAdminUpdatingUser() {
      let data = request.resource.data;
       // Admin can change role and status, but not immutable fields.
      return data.createdAt == resource.data.createdAt;
    }

    function isValidUsageEvent(userId) {
      let data = request.resource.data;
      return data.userId == userId
          && data.timestamp <= request.time;
    }

    // --- Collection Rules ---

    // Admin roles are managed via backend/console, not client.
    // A user can check if they are an admin, and an admin can check other users.
    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // User profiles can be read by owner or admin.
    // Only admins can list all users.
    // Users can create their own profile.
    // Users can update their own profile (with restrictions).
    // Admins can update any user's profile (role/status).
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isCreatingOwnUser();
      allow update: if (isOwner(userId) && isUpdatingOwnProfile()) || (isAdmin() && isAdminUpdatingUser());
      allow delete: if false; // Users should be suspended, not deleted.
    }

    // Usage events are private and immutable.
    // Only active users can create events.
    // Admins can read anyone's events for auditing.
    match /users/{userId}/usageEvents/{usageEventId} {
      allow read: if (isOwner(userId) && isSelfActive()) || isAdmin();
      allow create: if isOwner(userId) && isSelfActive() && isValidUsageEvent(userId);
      allow update, delete: if false;
    }
  }
}
