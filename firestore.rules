rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Check if the user is a member of the tenant
    function isTenantMember(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    // --- Collection Rules ---

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
    
    match /users/{userId} {
      // Allow user to read and update their own profile (necessary for client-side upsert/login)
      allow get: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow delete: if false;

      // Permissions for price calculations and legacy reports
      match /priceCalculations/{calculationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /diagnosisReports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Reports are only written via backend
      }
    }

    // Multi-tenant architecture for diagnostics and products
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isAdmin();
      
      match /diagnostics/{diagnosticId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        // Client cannot write directly to diagnostics, must go through Cloud Functions
        allow write: if false;
      }

      match /products/{productId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if false;
      }
    }

    match /billing_events/{eventId} {
      allow read, write: if false; // Only via Admin SDK / Webhooks
    }
  }
}