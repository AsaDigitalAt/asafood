rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function getPlanLimit(plan) {
      return {
        'convidado': 10,
        'plano_unico': 1,
        'plano_duplo': 2,
        'plano_acelerador': 4,
        'desenvolvedor': 999
      }[plan];
    }
    
    function isWithinMonthlyLimit(userId) {
        let user = get(/databases/$(database)/documents/users/$(userId)).data;
        let plan = user.plan;
        
        // Developer plan has no limits
        if (plan == 'desenvolvedor') {
            return true;
        }

        let usage = user.usage;
        let limit = getPlanLimit(plan);
        
        // Check if the usage cycle needs to be reset
        let currentMonth = request.time.month();
        // Ensure usage and cycleStart are not null before accessing properties
        let cycleMonth = usage != null && usage.cycleStart != null ? usage.cycleStart.month() : 0;
        
        let reportsThisCycle = (currentMonth == cycleMonth) ? usage.reportsThisCycle : 0;
        
        return reportsThisCycle < limit;
    }

    // --- Validation Functions ---
    function isCreatingOwnUser() {
      let data = request.resource.data;
      return data.email == request.auth.token.email
          && data.plan == 'plano_acelerador'
          && data.planStatus == 'active'
          && data.usage.reportsThisCycle == 0
          && data.usage.cycleStart == request.time
          && data.createdAt == request.time
          && data.lastLoginAt == request.time;
    }

    function isUpdatingOwnProfile() {
      let data = request.resource.data;
      let existingData = resource.data;
      let allowedKeys = ['lastLoginAt', 'usage'];

      // Disallow changing any field except the allowed ones
      if (data.keys().removeAll(allowedKeys).size() != 0) {
        return false;
      }

      // If 'lastLoginAt' is being updated, it must be to the current time
      let validLastLoginUpdate = !('lastLoginAt' in data) || data.lastLoginAt == request.time;
      
      // If 'usage' is being updated, it must be an increment or a reset
      let validUsageUpdate = !('usage' in data) ||
          // Case 1: Incrementing reports
          (data.usage.reportsThisCycle == existingData.usage.reportsThisCycle + 1 &&
            data.usage.cycleStart.toMillis() == existingData.usage.cycleStart.toMillis()
          ) ||
          // Case 2: Resetting cycle for a new month
          (data.usage.reportsThisCycle == 0 &&
            data.usage.cycleStart.month() != existingData.usage.cycleStart.month() &&
            data.usage.cycleStart.year() == request.time.year()
          );
          
      return validLastLoginUpdate && validUsageUpdate;
    }
    
    function isAdminUpdatingUser() {
      let data = request.resource.data;
       // Admin can change plan and status, but not immutable fields.
      return data.createdAt == resource.data.createdAt;
    }

    function isValidUsageEvent(userId) {
      let data = request.resource.data;
      // Also check if user is within their plan limit before allowing event creation
      return data.userId == userId
          && data.timestamp <= request.time
          && isWithinMonthlyLimit(userId);
    }

    function isUpdatingOwnUsageEventStatus(userId) {
        let data = request.resource.data;
        // User must be the owner
        return data.userId == userId
            // Only allow updating status and metadata.
            && data.action == resource.data.action
            && data.timestamp == resource.data.timestamp;
    }

    function isValidDiagnosisReport(userId) {
      let data = request.resource.data;
      return data.userId == userId
        && data.createdAt == request.time;
    }

    // --- Collection Rules ---

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
    
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isCreatingOwnUser();
      allow update: if (isOwner(userId) && isUpdatingOwnProfile()) || (isAdmin() && isAdminUpdatingUser());
      allow delete: if false;
      
      // --- Subcollection Rules ---
       match /usageEvents/{usageEventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidUsageEvent(userId);
        allow update: if isOwner(userId) && isUpdatingOwnUsageEventStatus(userId);
        allow delete: if false;
      }
      
      match /diagnosisReports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidDiagnosisReport(userId) && isWithinMonthlyLimit(userId);
        allow update, delete: if false;
      }
    }
  }
}
