rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Cada usuário pode ler/escrever SOMENTE na própria pasta de uploads
    match /diagnostics/uploads/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Bloqueia qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}