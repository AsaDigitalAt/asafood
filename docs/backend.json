{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the application, storing their profile information and Firebase Auth metadata.",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of when the user account was created.",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Timestamp of the user's last login.",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "description": "User's role within the application (e.g., 'admin', 'user').",
          "enum": [
            "user",
            "admin"
          ]
        },
        "status": {
          "type": "string",
          "description": "User's account status (e.g., 'active', 'suspended').",
          "enum": [
            "active",
            "suspended"
          ]
        },
        "plan": {
          "type": "string",
          "description": "User's subscription plan.",
          "enum": [
            "Plano Único",
            "Plano Duplo",
            "Plano Acelerador",
            "Modo Criador"
          ]
        }
      },
      "required": [
        "email",
        "createdAt",
        "lastLoginAt",
        "role",
        "status",
        "plan"
      ]
    },
    "UsageEvent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UsageEvent",
      "type": "object",
      "description": "Represents a usage event within the application, for auditing and usage tracking.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to the User who performed the action."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of when the usage event occurred.",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "description": "The action that was performed (e.g., 'login', 'generate_diagnosis')."
        },
        "status": {
          "type": "string",
          "description": "Status of the action (e.g., 'started', 'success', 'failure')."
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata related to the usage event."
        }
      },
      "required": [
        "userId",
        "timestamp",
        "action",
        "status"
      ]
    },
    "DiagnosisReport": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DiagnosisReport",
      "type": "object",
      "description": "Stores the result of a generated diagnosis report from the webhook.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who generated the report."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of when the report was created.",
          "format": "date-time"
        },
        "nome": {
          "type": "string"
        },
        "statusGeral": {
          "type": "string"
        },
        "conversions": {
          "type": "object"
        },
        "discounts": {
          "type": "object"
        },
        "problems": {
          "type": "array"
        },
        "actions": {
          "type": "array"
        },
        "priorities": {
          "type": "array"
        },
        "aiGeneratedPlan": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "userId",
        "createdAt",
        "nome",
        "statusGeral"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profile information. The document ID is the Firebase UID. Role and status are used for access control."
    },
    "/users/{userId}/usageEvents/{usageEventId}": {
      "schema": {
        "$ref": "#/entities/UsageEvent"
      },
      "description": "Stores immutable usage events for each user. Path-based ownership ensures users can only access their own events."
    },
    "/users/{userId}/diagnosisReports/{reportId}": {
      "schema": {
        "$ref": "#/entities/DiagnosisReport"
      },
      "description": "Stores the diagnosis reports generated by a user."
    },
    "/roles_admin/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "isAdmin": {
            "type": "boolean"
          }
        }
      },
      "description": "Collection for admin role management. The existence of a document with a user's UID grants admin privileges. Document content is irrelevant; only existence matters."
    }
  }
}